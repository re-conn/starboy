#include "starboy-layouts.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    matrix_transform0: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <15>;
        rows = <15>;
        map = <
            RC(0,1) RC(1,0) RC(2,1) RC(1,2) RC(3,1) RC(1,3) RC(4,1) RC(1,4) RC(5,1) RC(1,5) RC(6,1) RC(1,6) RC(7,1) RC(1,7) RC(1,10)
            RC(0,8) RC(8,0) RC(2,8) RC(8,2) RC(3,8) RC(8,3) RC(4,8) RC(8,4) RC(5,8) RC(8,5) RC(6,8) RC(8,6) RC(7,8) RC(8,7) RC(9,8) RC(8,9) RC(10,8) RC(8,10)
            RC(0,11) RC(11,0) RC(2,11) RC(11,2) RC(3,11) RC(11,3) RC(4,11) RC(11,4) RC(5,11) RC(11,5) RC(6,11) RC(11,6) RC(7,11) RC(11,7) RC(9,11) RC(11,9) RC(10,11) RC(11,10)
            RC(0,12) RC(12,0) RC(2,12) RC(12,2) RC(3,12) RC(12,3) RC(4,12) RC(12,4) RC(5,12) RC(12,5) RC(6,12) RC(12,6) RC(7,12) RC(9,12) RC(12,9) RC(10,12) 
            RC(0,13) RC(13,0) RC(2,13) RC(13,2) RC(3,13) RC(13,3) RC(4,13) RC(13,4) RC(5,13) RC(13,5) RC(6,13) RC(13,6) RC(13,7) RC(9,13) RC(13,9) RC(10,13)
            RC(0,14) RC(14,0) RC(2,14) RC(14,3) RC(5,14) RC(14,5) RC(6,14) RC(7,14) RC(14,7) RC(9,14) RC(14,9) RC(10,14) RC(14,10)
        >;
    };
};

&physical_layout_starboy {
    transform = <&matrix_transform0>;
};

// Encoders for all parts of the keyboard.
// If the encoder(s) are not behaving as expected,
// update steps and triggers-per-rotation to match your hardware.
// All pin assignments are done in the part overlays.

/ {
    encoder0: encoder0 {
        compatible = "alps,ec11";
        steps = <24>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <20>;
    };
};

