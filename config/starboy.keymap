#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Starboy";
            bindings = <
                &kp ESC &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_PRV &bt BT_NXT &bt BT_CLR &bt BT_CLR_ALL &kp F1 &kp F2 &kp F3 &soft_off &bootloader &kp C_MUTE
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N7 &kp N6 &kp N8 &kp N9 &kp N0 &kp MINUS  &kp EQUAL   &kp BSPC   &kp DEL   &kp KP_SLASH   &kp KP_MULTIPLY   &kp KP_MINUS
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH &kp KP_NUMBER_7    &kp KP_NUMBER_8    &kp KP_NUMBER_9    &kp KP_PLUS
                &kp CLCK &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp RET &kp KP_NUMBER_4   &kp KP_NUMBER_5  &kp KP_NUMBER_6
                &kp LSHFT  &kp Z &kp X  &kp C &kp V   &kp B  &kp N  &kp M  &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT  &kp UP  &kp KP_NUMBER_1   &kp KP_NUMBER_2  &kp KP_NUMBER_3  
                &kp LCTRL &kp LGUI &kp LALT &kp SPACE &kp RALT &kp RGUI &kp RCTRL &kp LEFT &kp DOWN &kp RIGHT &kp KP_NUMBER_0 &kp KP_DOT &kp KP_ENTER
            >;
            sensor-bindings = <&inc_dec_kp N1 N2>;
        };
    };
};
